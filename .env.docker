# Docker Environment - copy this to .env.docker and fill in real values
# Used by docker-compose via env_file directive

DJANGO_SECRET_KEY=django-insecure-change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# MySQL (must match docker-compose db service)
DB_PASSWORD=medical_pass_2024
MYSQL_ROOT_PASSWORD=root_pass_2024

# SiliconFlow API (required for QA functionality)
SILICONFLOW_API_KEY=your-api-key-here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
